# OpenRouter. Do not commit the key. Copy OPENROUTER_API_KEY from the viettel-race .env when wiring calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Graph writer, ReAct loop, and answerer. Zep used gpt-4o-mini-2024-07-18.
LLM_MODEL=openai/gpt-4o-mini

# Half the token price of text-embedding-3-small. Dimension is 4096.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
